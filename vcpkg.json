{
  "name": "xstd-bits",
  "version-string": "0.1.0",
  "description": "Bit-packed C++ containers, views and bitsets modelling their standard counterparts, with the bit-parallel operations packing makes possible",
  "homepage": "https://github.com/rhalbersma/xstd-bits",
  "license": "BSL-1.0",
  "dependencies": [
    "boost-container",
    "boost-hash2"
  ],
  "default-features": [
    "test"
  ],
  "features": {
    "dynamic-bitset": {
      "description": "Interoperate with boost::dynamic_bitset through <xstd/bits/ext/boost/dynamic_bitset.hpp>",
      "dependencies": [
        "boost-dynamic-bitset"
      ]
    },
    "test": {
      "description": "Build the unit tests and benchmarks",
      "dependencies": [
        "boost-test",
        "boost-dynamic-bitset",
        "boost-unordered",
        "benchmark",
        "range-v3"
      ]
    }
  }
}
