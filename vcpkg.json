{
  "name": "xstd-bits",
  "version-string": "0.1.0",
  "description": "Bitwise extensions to the C++ Standard Library",
  "homepage": "https://github.com/rhalbersma/xstd-bits",
  "license": "BSL-1.0",
  "dependencies": [
    "boost-container"
  ],
  "default-features": [
    "test"
  ],
  "features": {
    "dynamic-bitset": {
      "description": "Interoperate with boost::dynamic_bitset through <xstd/bits/ext/boost/dynamic_bitset.hpp>",
      "dependencies": [
        "boost-dynamic-bitset"
      ]
    },
    "hash2": {
      "description": "Hash the containers through std::hash, bit_hash and bit_digest, whose headers include Boost.Hash2",
      "dependencies": [
        "boost-hash2"
      ]
    },
    "test": {
      "description": "Build the unit tests and benchmarks",
      "dependencies": [
        "boost-test",
        "boost-dynamic-bitset",
        "boost-hash2",
        "boost-iterator",
        "boost-unordered",
        "benchmark",
        "range-v3"
      ]
    }
  }
}
